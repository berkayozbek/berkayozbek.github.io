g": "lazy", "decoding": "async"}, "children": []}, {"tag": "span", "attrs": {"class": "enlarge"}, "children": ["Enlarge ↗"]}]}, {"tag": "figcaption", "attrs": {}, "children": [{"tag": "strong", "attrs": {}, "children": ["Layout of the proposed analog front-end"]}, {"tag": "p", "attrs": {}, "children": ["The 2.4 mm² layout contains the LNA, filterbank, variable-gain amplifiers, current generation and control. The complete AFE is evaluated through simulation in this thesis."]}, {"tag": "a", "attrs": {"class": "source", "href": "/documents/Berkay_Ozbek_MSc_Thesis.pdf#page=107", "target": "_blank", "rel": "noopener"}, "children": ["MSc thesis · Fig. 3.34 · p. 89 ", {"tag": "span", "attrs": {"aria-hidden": "true"}, "children": ["↗"]}]}]}]}]}, "\n", {"tag": "div", "attrs": {"class": "table-wrap", "tabindex": "0", "role": "region", "aria-label": "Complete analog front-end: simulation summary"}, "children": [{"tag": "table", "attrs": {}, "children": [{"tag": "caption", "attrs": {}, "children": ["Complete analog front-end: simulation summary"]}, {"tag": "thead", "attrs": {}, "children": [{"tag": "tr", "attrs": {}, "children": [{"tag": "th", "attrs": {"scope": "col"}, "children": ["Parameter"]}, {"tag": "th", "attrs": {"scope": "col"}, "children": ["Result"]}, {"tag": "th", "attrs": {"scope": "col"}, "children": ["Context"]}]}]}, {"tag": "tbody", "attrs": {}, "children": [{"tag": "tr", "attrs": {}, "children": [{"tag": "th", "attrs": {"scope": "row"}, "children": ["Channels / acoustic coverage"]}, {"tag": "td", "attrs": {}, "children": ["12 / approximately 85–6500 Hz"]}, {"tag": "td", "attrs": {}, "children": ["Channel-specific centre frequency and bandwidth."]}]}, {"tag": "tr", "attrs": {}, "children": [{"tag": "th", "attrs": {"scope": "row"}, "children": ["Default power"]}, {"tag": "td", "attrs": {}, "children": ["9.03 µW"]}, {"tag": "td", "attrs": {}, "children": ["All channels active at default settings."]}]}, {"tag": "tr", "attrs": {}, "children": [{"tag": "th", "attrs":